{
  "name": "obsidian-deepharness-bridge",
  "version": "0.3.18",
  "private": true,
  "description": "Obsidian companion bridge for DeepSeek Harness conversations",
  "dshKnowledge": {
    "annotationProtocolVersion": 2,
    "stickerProtocolVersion": 1
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "third-party",
      "artifact": "manifest.json"
    },
    "install": {
      "mode": "guided",
      "adapter": "obsidian-community-plugin",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-plugin",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:vault",
      "network:loopback",
      "ui:modify"
    ],
    "evidence": {
      "install": "docs/release/verification.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "type": "module",
  "license": "MIT",
  "main": "main.js",
  "files": [
    "main.js",
    "styles.css",
    "manifest.json",
    "versions.json",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm pack --dry-run --json",
    "package:companion": "node scripts/package-companion.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.3.0",
    "dsh-annotation-core": "git+https://github.com/linmu115/dsh-annotation-core.git#codex/bidirectional-reference-delete",
    "jsdom": "26.1.0",
    "obsidian": "^1.13.1",
    "tar": "^7.5.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/obsidian-deepharness-bridge.git"
  }
}
